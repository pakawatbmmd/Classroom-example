# 3. PRESENTATION LAYER (VIEWS)
# =====================================================================
class ConsoleView:
  """Handles layout formatting, sanitized user prompts, and visual report outputs."""

  @staticmethod
  def display_main_menu() -> str:
    print("\n" + "=" * 40 + "\n     DIABETES RISK SCORING SYSTEM\n" + "=" * 40)
    print("1. Assess Patient Risk\n2. Exit\n" + "-" * 40)
    return input("Select an option (1-2): ").strip()

  @staticmethod
  def display_patient_ids(ids: List[int]) -> None:
    print(f"\nAvailable Patient IDs: {', '.join(map(str, ids))}")

  @staticmethod
  def prompt_patient_id() -> str:
    return input("Enter Patient ID to assess: ").strip()

  @staticmethod
  def display_error(message: str) -> None:
    print(f"\n[ERROR] {message}")

  @staticmethod
  def display_profile(patient_id: int, metrics: Dict[str, float]) -> None:
    print(f"\n--- Clinical Profile for Patient {patient_id} ---")
    for metric, val in metrics.items():
      formatted_val = int(val) if metric == "Age" and val.is_integer() else val
      print(f" * {metric}: {formatted_val}")

  @staticmethod
  def prompt_modification_choice() -> bool:
    return (
        input(
            "\nDo you want to modify any metrics before calculation? (y/n): "
        )
        .strip()
        .lower()
        == "y"
    )

  @staticmethod
  def prompt_metric_update(metric_name: str, current_value: float) -> float:
    user_input = input(
        f"Enter new {metric_name} [Current: {current_value}] (Or press Enter to"
        " keep): "
    ).strip()
    if user_input == "":
      return current_value
    try:
      val = float(user_input)
      if math.isnan(val) or math.isinf(val) or val < 0:
        print(
            "[Invalid Input] Value must be a non-negative finite number."
            " Keeping original value."
        )
        return current_value
      return val
    except ValueError:
      print("[Invalid Input] Keeping original value.")
      return current_value

  @staticmethod
  def display_diagnostic_report(
      patient_id: int, score: int, category: str
  ) -> None:
    """Displays diagnostic report as an official medical receipt with decorative borders and confidentiality warnings."""
    border_equal = "=" * 48
    border_dash = "-" * 48
    border_star = "*" * 48

    print(f"\n{border_equal}")
    print("          OFFICIAL MEDICAL DIAGNOSTIC RECEIPT         ")
    print("             DIABETES RISK ASSESSMENT REPORT          ")
    print(f"{border_equal}")
    print(f" Transaction ID   : PAT-{patient_id:05d}")
    print(f" Patient ID       : {patient_id}")
    print(f"{border_dash}")
    print(f" Cumulative Score : {score} pts")
    print(f" Risk Category    : {category.upper()}")
    print(f"{border_dash}")
    print(f"{border_star}")
    print("  [!] CONFIDENTIAL MEDICAL RECORD - FOR AUTHORIZED USE ONLY [!]")
    print(f"{border_star}\n")

    # Optional rich HTML rendering in Google Colab / Jupyter
    try:
      from IPython.display import HTML, display

      color = (
          "#2e7d32"
          if "Low" in category
          else "#f57c00" if "Moderate" in category else "#c62828"
      )
      html_content = f"""
            <div style="border: 2px dashed #444; padding: 16px; border-radius: 4px; width: 380px; font-family: 'Courier New', monospace; background-color: #fffde7; box-shadow: 2px 2px 8px rgba(0,0,0,0.15);">
                <div style="text-align: center; border-bottom: 2px solid #333; padding-bottom: 8px; margin-bottom: 12px;">
                    <h4 style="margin: 0; color: #222; letter-spacing: 1px;">OFFICIAL MEDICAL DIAGNOSTIC RECEIPT</h4>
                    <p style="margin: 3px 0 0 0; font-size: 11px; color: #555;">DIABETES RISK ASSESSMENT REPORT</p>
                </div>
                <p style="margin: 4px 0; font-size: 13px;"><b>Transaction ID:</b> PAT-{patient_id:05d}</p>
                <p style="margin: 4px 0; font-size: 13px;"><b>Patient ID:</b> {patient_id}</p>
                <hr style="border: none; border-top: 1px dashed #aaa; margin: 10px 0;" />
                <p style="margin: 4px 0; font-size: 13px;"><b>Cumulative Score:</b> {score} pts</p>
                <p style="margin: 4px 0; font-size: 13px;"><b>Risk Category:</b> <span style="color: {color}; font-weight: bold;">{category.upper()}</span></p>
                <div style="margin-top: 14px; padding: 8px; background-color: #ffebee; border: 1px solid #ef5350; text-align: center; font-size: 10px; font-weight: bold; color: #c62828; letter-spacing: 0.5px;">
                    CONFIDENTIAL MEDICAL RECORD - FOR AUTHORIZED USE ONLY
